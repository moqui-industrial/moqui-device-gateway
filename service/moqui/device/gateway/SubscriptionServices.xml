<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="SubscriptionState" type="rust"
             location="moqui_device_gateway::binding::subscription_state" authenticate="false" transaction="ignore">
        <description>The subscriptions of this process: running, and ended without an unsubscribe.</description>
        <in-parameters>
            <parameter name="claimStartup" type="Boolean"><description>true: claim the startup restoration;
                startupClaimed is true for the first claim in this process only.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="activeRequestNames" type="List"/>
            <parameter name="droppedRequestNames" type="List"/>
            <parameter name="startupClaimed" type="Boolean"/>
        </out-parameters>
    </service>

    <service verb="get" noun="GatewayScope" authenticate="false">
        <description>
            The identity and scope of a gateway, as the former gateway checked them. The gateway must be a Device with a
            PhysicalDevice and a DgmpEdgeGateway member of at least one DeviceGroup (statusId empty or DgmsAlive). Its
            scope is those groups and their alive members, recursively; the controllers of the scope are the members
            with a controller purpose (DgmpProcessPLC, DgmpSafetyPLC, DgmpController, DgmpMotionController,
            DgmpRemoteIO, DgmpSafetyRemoteIO, DgmpExtremeConditionRemoteIO).
        </description>
        <in-parameters>
            <parameter name="gatewayDeviceId"><description>Default: the property device_gateway_device_id.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="gatewayDeviceId"/>
            <parameter name="ready" type="Boolean"/>
            <parameter name="message"/>
            <parameter name="scopedDeviceIds" type="List"/>
            <parameter name="controllerDeviceIds" type="List"/>
        </out-parameters>
        <actions>
            <set field="gatewayDeviceId" from="gatewayDeviceId || System.getProperty('device_gateway_device_id') || null"/>
            <set field="ready" from="false"/>
            <set field="scopedDeviceIds" from="[]"/>
            <set field="controllerDeviceIds" from="[]"/>
            <if condition="!gatewayDeviceId">
                <set field="message" value="No gateway identity: set the property device_gateway_device_id."/>
                <return/>
            </if>
            <entity-find-one entity-name="moqui.device.Device" value-field="device">
                <field-map field-name="deviceId" from="gatewayDeviceId"/>
            </entity-find-one>
            <entity-find-one entity-name="moqui.device.PhysicalDevice" value-field="physicalDevice">
                <field-map field-name="deviceId" from="gatewayDeviceId"/>
            </entity-find-one>
            <if condition="!device || !physicalDevice">
                <set field="message" value="Configured gateway ${gatewayDeviceId} does not exist as Device + PhysicalDevice."/>
                <return/>
            </if>
            <entity-find entity-name="moqui.device.DeviceGroupMember" list="gatewayMemberships">
                <econdition field-name="memberDeviceId" from="gatewayDeviceId"/>
                <econdition field-name="purposeEnumId" value="DgmpEdgeGateway"/>
            </entity-find>
            <set field="pendingGroupIds" from="gatewayMemberships.filter((member => member.statusId == null || member.statusId === 'DgmsAlive')).map(member => member.deviceId)"/>
            <if condition="!pendingGroupIds.length">
                <set field="message" value="Gateway ${gatewayDeviceId} is not assigned to any DeviceGroup as DgmpEdgeGateway."/>
                <return/>
            </if>
            <set field="controllerPurposes" from="['DgmpProcessPLC', 'DgmpSafetyPLC', 'DgmpController', 'DgmpMotionController',
                'DgmpRemoteIO', 'DgmpSafetyRemoteIO', 'DgmpExtremeConditionRemoteIO']"/>
            <set field="scopedDeviceIds" from="[...pendingGroupIds]"/>
            <!-- the groups of the gateway and their alive members, recursively -->
            <while condition="pendingGroupIds.length">
                <set field="groupId" from="pendingGroupIds.shift()"/>
                <entity-find entity-name="moqui.device.DeviceGroupMember" list="members">
                    <econdition field-name="deviceId" from="groupId"/>
                </entity-find>
                <iterate list="members.filter((member => member.statusId == null || member.statusId === 'DgmsAlive'))" entry="member">
                    <if condition="controllerPurposes.includes(member.purposeEnumId) &amp;&amp; !controllerDeviceIds.includes(member.memberDeviceId)">
                        <set field="controllerDeviceIds" from="controllerDeviceIds.concat([member.memberDeviceId])"/>
                    </if>
                    <if condition="!scopedDeviceIds.includes(member.memberDeviceId)">
                        <set field="scopedDeviceIds" from="scopedDeviceIds.concat([member.memberDeviceId])"/>
                        <set field="pendingGroupIds" from="pendingGroupIds.concat([member.memberDeviceId])"/>
                    </if>
                </iterate>
            </while>
            <set field="ready" from="true"/>
            <set field="message" value="ready"/>
        </actions>
    </service>

    <service verb="get" noun="StartupSubscriptions" authenticate="false">
        <description>
            The subscriptions a gateway starts: the active (fromDate, thruDate) DeviceRequest records of type
            DrtSubscribe, DrtEvent, DrtStateChange or DrtCyclic, run by a service of this component, whose device is a
            controller in the scope of the gateway (get#GatewayScope); ordered by priority, sequenceNum, requestName.
        </description>
        <in-parameters>
            <parameter name="gatewayDeviceId"><description>Default: the property device_gateway_device_id.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="gatewayDeviceId"/>
            <parameter name="ready" type="Boolean"/>
            <parameter name="message"/>
            <parameter name="requestNames" type="List"/>
        </out-parameters>
        <actions>
            <service-call name="moqui.device.gateway.SubscriptionServices.get#GatewayScope" out-map="scope"
                    in-map="{gatewayDeviceId:gatewayDeviceId}"/>
            <set field="gatewayDeviceId" from="scope.gatewayDeviceId"/>
            <set field="ready" from="scope.ready"/>
            <set field="message" from="scope.message"/>
            <set field="requestNames" from="[]"/>
            <if condition="!ready"><return/></if>
            <entity-find entity-name="moqui.device.DeviceRequest" list="requestList">
                <econdition field-name="deviceId" operator="in" from="scope.controllerDeviceIds"/>
                <econdition field-name="requestTypeEnumId" operator="in" from="['DrtSubscribe', 'DrtEvent', 'DrtStateChange', 'DrtCyclic']"/>
                <econdition field-name="runServiceName" operator="like" value="moqui.device.gateway.%"/>
                <date-filter/>
            </entity-find>
            <!-- no priority or sequenceNum sorts last, as COALESCE(..., 999999) did -->
            <set field="requestNames" from="Array.from(requestList).sort((a, b) => {
                    const key = value => value == null ? 999999 : (typeof value.toNumber === 'function' ? value.toNumber() : Number(value));
                    return (key(a.priority) - key(b.priority)) || (key(a.sequenceNum) - key(b.sequenceNum))
                        || (a.requestName &lt; b.requestName ? -1 : (a.requestName > b.requestName ? 1 : 0));
                }).map(r => r.requestName)"/>
        </actions>
    </service>

    <service verb="start" noun="Subscriptions" authenticate="false" transaction="ignore">
        <description>
            Starts the subscriptions of the gateway. The first call in a process starts get#StartupSubscriptions: the
            subscriptions of the controllers in the scope of the gateway (property device_gateway_device_id; without
            it nothing is restored). A later call restarts only the subscriptions that ended without an unsubscribe
            (a lost connection). An unsubscribed request stays stopped until it is run again.

            The service job start_DeviceGatewaySubscriptions calls it every minute: mr-moqui has no startup hook, so the
            first run after a start restores the subscriptions. Set the property device_gateway_restore_subscriptions
            to false on an instance that must not own the subscriptions.
        </description>
        <out-parameters>
            <parameter name="startedRequestNames" type="List"/>
            <parameter name="failedRequestNames" type="List"/>
        </out-parameters>
        <actions>
            <set field="startedRequestNames" from="[]"/>
            <set field="failedRequestNames" from="[]"/>
            <if condition="System.getProperty('device_gateway_restore_subscriptions') === 'false'"><return/></if>
            <service-call name="moqui.device.gateway.SubscriptionServices.get#SubscriptionState" out-map="state"
                    in-map="{claimStartup:true}"/>
            <set field="requestNames" from="state.droppedRequestNames || []"/>
            <if condition="state.startupClaimed">
                <service-call name="moqui.device.gateway.SubscriptionServices.get#StartupSubscriptions" out-map="startup"/>
                <if condition="startup.ready"><then>
                    <set field="activeNames" from="state.activeRequestNames || []"/>
                    <set field="requestNames" from="requestNames.concat((startup.requestNames || [])
                        .filter(name => !activeNames.includes(name) &amp;&amp; !requestNames.includes(name)))"/>
                </then><else>
                    <log level="warn" message="Device gateway subscriptions are not restored: ${startup.message}"/>
                </else></if>
            </if>
            <iterate list="requestNames" entry="requestName">
                <!-- a request that does not start is logged by ignore-error and the others still start -->
                <set field="startOut" from="null"/>
                <service-call name="moqui.device.DeviceServices.run#DeviceRequest" out-map="startOut" ignore-error="true"
                        in-map="{requestName:requestName}"/>
                <if condition="['active', 'completed'].includes(startOut?.status)"><then>
                    <set field="startedRequestNames" from="startedRequestNames.concat([requestName])"/>
                </then><else>
                    <set field="failedRequestNames" from="failedRequestNames.concat([requestName])"/>
                    <log level="warn" message="Device gateway subscription ${requestName} did not start"/>
                </else></if>
            </iterate>
            <if condition="startedRequestNames.length || failedRequestNames.length">
                <log level="info" message="Device gateway subscriptions started: ${startedRequestNames.length}, failed: ${failedRequestNames.length}"/>
            </if>
        </actions>
    </service>
</services>
