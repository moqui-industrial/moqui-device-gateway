<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf>
    <!-- The broker of the broker requests: broker-uri, broker-username and broker-password of moqui-device's element.
         error-notification(-seconds): a Moqui notification after this many seconds of failing stores of a request;
         false turns it off. queue-capacity: batches of samples waiting for the database; polling and OPC UA samples
         beyond it are discarded and notified. -->
    <moqui-device-gateway error-notification="true" error-notification-seconds="60" queue-capacity="1024"/>
    <tools><tool-factory class="moqui_device_gateway::DeviceGatewayToolFactory" init-priority="30"/></tools>
</moqui-conf>
